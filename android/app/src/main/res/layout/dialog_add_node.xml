<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/colorSurface">

    <TextView
        android:id="@+id/node_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Node"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/node_name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Node Name"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="@color/text_secondary"
        android:background="?attr/colorSurface"
        android:padding="12dp"
        android:inputType="textCapWords" />

    <EditText
        android:id="@+id/node_rpc_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="RPC URL"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="@color/text_secondary"
        android:background="?attr/colorSurface"
        android:padding="12dp"
        android:fontFamily="monospace"
        android:inputType="textUri" />

    <EditText
        android:id="@+id/node_explorer_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Explorer URL"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="@color/text_secondary"
        android:background="?attr/colorSurface"
        android:padding="12dp"
        android:fontFamily="monospace"
        android:inputType="textUri" />

</LinearLayout>
