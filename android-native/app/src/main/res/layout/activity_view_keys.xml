<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/view_keys_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:navigationIconTint="?attr/colorOnSurface"
            android:title="View Keys"
            android:titleTextColor="?attr/colorOnSurface" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Address -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Address"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/key_address_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="-"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:fontFamily="monospace" />
                    <ImageButton
                        android:id="@+id/copy_address_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Copy address"
                        android:padding="8dp"
                        android:src="@drawable/ic_content_copy"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <!-- Public Key -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Public Key"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/key_pubkey_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="-"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:fontFamily="monospace" />
                    <ImageButton
                        android:id="@+id/copy_pubkey_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Copy public key"
                        android:padding="8dp"
                        android:src="@drawable/ic_content_copy"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <!-- View Pubkey -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Pubkey"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/key_view_pubkey_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="-"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:fontFamily="monospace" />
                    <ImageButton
                        android:id="@+id/show_view_pubkey_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Show/hide view pubkey"
                        android:padding="8dp"
                        android:src="@drawable/ic_visibility"
                        app:tint="?attr/colorPrimary" />
                    <ImageButton
                        android:id="@+id/copy_view_pubkey_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Copy view pubkey"
                        android:padding="8dp"
                        android:src="@drawable/ic_content_copy"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <!-- Private Key -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Private Key"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/key_privkey_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="-"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:fontFamily="monospace" />
                    <ImageButton
                        android:id="@+id/show_privkey_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Show/hide private key"
                        android:padding="8dp"
                        android:src="@drawable/ic_visibility"
                        app:tint="?attr/colorPrimary" />
                    <ImageButton
                        android:id="@+id/copy_privkey_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Copy private key"
                        android:padding="8dp"
                        android:src="@drawable/ic_content_copy"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <!-- Seed Phrase (mnemonic) — only for mnemonic wallets, hidden by default -->
                <TextView
                    android:id="@+id/mnemonic_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seed Phrase (12 Words)"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/mnemonic_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/key_mnemonic_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="••••• ••••• ••••• •••••"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:fontFamily="monospace" />
                    <ImageButton
                        android:id="@+id/show_mnemonic_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Show/hide seed phrase"
                        android:padding="8dp"
                        android:src="@drawable/ic_visibility"
                        app:tint="?attr/colorPrimary" />
                    <ImageButton
                        android:id="@+id/copy_mnemonic_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Copy seed phrase"
                        android:padding="8dp"
                        android:src="@drawable/ic_content_copy"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Derive Child Wallet — only for mnemonic wallets -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/derive_child_wallet_button"
            style="@style/Widget.OctraWallet.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Derive Child Wallet"
            android:visibility="gone"
            app:icon="@android:drawable/ic_menu_manage"
            app:iconGravity="textStart" />

        <!-- Export Wallet Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/export_wallet_button"
            style="@style/Widget.OctraWallet.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Export Wallet File"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart" />

    </LinearLayout>
</ScrollView>
