<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Octra Wallet"
        android:textColor="?attr/colorOnSurface"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your 6-digit PIN to unlock"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:layout_marginTop="24dp" />

    <EditText
        android:id="@+id/unlock_pin_input"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:hint="------"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="@color/text_secondary"
        android:background="?attr/colorSurface"
        android:padding="16dp"
        android:gravity="center"
        android:letterSpacing="0.5"
        android:textSize="24sp"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:layout_marginTop="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/unlock_button"
        style="@style/Widget.OctraWallet.Button.Tonal"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Unlock"
        android:layout_marginTop="24dp" />

    <!-- Biometric unlock button (hidden when hardware not available) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/unlock_biometric_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Use Biometrics"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:icon="@drawable/ic_lock" />

    <!-- Hints about biometric status -->
    <TextView
        android:id="@+id/unlock_biometric_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
