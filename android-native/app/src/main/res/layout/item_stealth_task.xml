<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardElevation="1dp"
    app:cardCornerRadius="12dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurface">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/stealth_task_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Task: -"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/stealth_task_to"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="To: -"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/stealth_task_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Amount: -"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/stealth_task_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: -"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/stealth_task_step"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Step: -"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/stealth_task_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Message: -"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/stealth_task_hash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Tx Hash: -"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/stealth_task_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Updated: -"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
