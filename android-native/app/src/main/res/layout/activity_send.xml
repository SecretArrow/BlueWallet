<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/tx_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/send_title_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Send OCT"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/send_subtitle_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Enter recipient, amount, then send the transaction."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/send_available_balance_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Available: —"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/send_amount_preview_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorPrimaryContainer"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Amount"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/send_amount_preview_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0 OCT"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <EditText
                        android:id="@+id/send_to_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="?attr/colorSurface"
                        android:hint="Recipient Address"
                        android:fontFamily="monospace"
                        android:inputType="textMultiLine"
                        android:gravity="start|top"
                        android:minLines="2"
                        android:maxLines="4"
                        android:padding="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="@color/text_secondary" />

                    <EditText
                        android:id="@+id/send_amount_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="?attr/colorSurface"
                        android:hint="Amount (OCT)"
                        android:inputType="numberDecimal"
                        android:padding="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="@color/text_secondary" />

                    <EditText
                        android:id="@+id/send_message_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="?attr/colorSurface"
                        android:hint="Message (Optional)"
                        android:inputType="textMultiLine"
                        android:gravity="start|top"
                        android:minLines="2"
                        android:maxLines="4"
                        android:padding="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="@color/text_secondary" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/send_custom_fee_check"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Use custom gas fee (OU)"
                        android:textColor="?attr/colorOnSurface" />

                    <EditText
                        android:id="@+id/send_custom_fee_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="?attr/colorSurface"
                        android:enabled="false"
                        android:hint="Fee (OU), default 1000"
                        android:inputType="number"
                        android:padding="12dp"
                        android:text="1000"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="@color/text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/send_submit_button"
                        style="@style/Widget.OctraWallet.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Send Transaction" />
            </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/send_fab_tx_manager"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Transactions Manager"
        android:src="@drawable/ic_detail_actions"
        app:fabSize="normal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
