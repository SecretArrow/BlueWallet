<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Cleartext for loopback only. The legacy devnet IP (165.227.225.79:8080)
      used to be listed here; it is dead (probe: connection refused) and
      UrlSecurityValidator.normalizeRpcUrl rewrites it to the live HTTPS
      default, so the exemption only widened the cleartext surface.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
    <!-- HTTPS-only for mainnet and explorer endpoints -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">rpc.octrascan.io</domain>
        <domain includeSubdomains="true">octrascan.io</domain>
        <domain includeSubdomains="true">devnet.octrascan.io</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
