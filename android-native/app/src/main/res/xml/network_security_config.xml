<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      HTTPS-only. The former loopback cleartext exception (127.0.0.1 /
      localhost / 10.0.2.2) for the local dApp server was removed with the
      server itself (PR #48); the legacy devnet IP (165.227.225.79:8080) is
      dead (probe: connection refused) and UrlSecurityValidator.normalizeRpcUrl
      rewrites it to the live HTTPS default. No cleartext exception remains.
    -->
    <!-- HTTPS-only for mainnet and explorer endpoints -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">rpc.octrascan.io</domain>
        <domain includeSubdomains="true">octrascan.io</domain>
        <domain includeSubdomains="true">devnet.octrascan.io</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
