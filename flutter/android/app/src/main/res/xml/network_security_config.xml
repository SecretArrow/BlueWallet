<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS-only. The former local web server on loopback
  (http://127.0.0.1:8420) was removed: dApps load over HTTPS in the
  in-app WebView and talk to the wallet through the isolated
  OctraWalletBridge JavaScript channel. No cleartext exception remains.
-->
<network-security-config>
    <!-- HTTPS-only for everything (nodes, explorers, dApps). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
